.LSOverride

# Application generated files
data/.session_recovery.json
data/history_*.json
logs/

# Runtime lock files (not uv.lock, which is tracked)
config.lock
data/.session_recovery.lock
data/history_*.lock

# Keep the data directory but ignore generated files
!data/.gitkeep

# Local development
*.local.json
.mypy_cache/
.ruff_cache/

# Team files (contain personal data) - keep only sample
teams/*.json
!teams/sample_team.json
